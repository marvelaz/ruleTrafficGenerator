# =============================================================================
# config.yaml — FortiGate Rule Optimization Lab
# =============================================================================
# Fill in your FortiGate and FortiAnalyzer IPs, API tokens, and interface names
# before running any phase. All other values have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# FortiGate
# -----------------------------------------------------------------------------
fortigate:
  host:              "192.168.1.4"   # FortiGate inside-interface IP (reachable from Linux Host A)
  port:              443
  api_token:         "REPLACE_ME"    # REST API token (System > API Tokens)
  vdom:              "root"          # Target VDOM
  verify_ssl:        false           # Set true in production with valid cert
  timeout:           30              # HTTP request timeout in seconds
  inside_interface:  "port2"         # FortiGate interface facing the inside (LinuxA) network
  outside_interface: "port1"         # FortiGate interface facing the outside (LinuxB) network

# -----------------------------------------------------------------------------
# FortiAnalyzer (OPTIONAL — only needed if you completed the FortiAnalyzer
# appendix in Lab 1 and want Phase 4 cleanup to also purge FAZ log entries.
# Leave the entire block commented out for the FortiGate-only workshop path.)
# -----------------------------------------------------------------------------
# fortianalyzer:
#   host:       "172.16.0.5"        # FortiAnalyzer management IP or FQDN
#   port:       443
#   api_token:  "REPLACE_ME"        # FAZ API token (System Settings > Admin > API)
#   adom:       "root"              # ADOM containing the FortiGate device
#   verify_ssl: false
#   timeout:    30

# -----------------------------------------------------------------------------
# Network — Linux hosts (LinuxA = inside, LinuxB = outside)
# -----------------------------------------------------------------------------
network:
  inside:
    primary_ip:       "192.168.1.100"
    linux_interface:  "eth0"           # Interface to add aliases on (LinuxA)
    subnets:                           # Subnets used for rule generation (Phase 1)
      - "192.168.1.0/24"               # Add more subnets here for on-prem labs; keep single /24 for cloud
    aliases:                           # Virtual IPs added by --setup-aliases
      - "192.168.1.101"
      - "192.168.1.102"
      - "192.168.1.103"
      - "192.168.1.104"
      - "192.168.1.105"
      - "192.168.1.106"
      - "192.168.1.107"
      - "192.168.1.108"
      - "192.168.1.109"
      - "192.168.1.110"

  outside:
    primary_ip:       "10.10.0.100"
    linux_interface:  "eth0"           # Interface to add aliases on (LinuxB)
    subnets:                           # Subnets used for rule generation (Phase 1)
      - "10.10.0.0/24"                 # Add more subnets here for on-prem labs; keep single /24 for cloud
    aliases:
      - "10.10.0.101"
      - "10.10.0.102"
      - "10.10.0.103"
      - "10.10.0.104"
      - "10.10.0.105"
      - "10.10.0.106"
      - "10.10.0.107"
      - "10.10.0.108"
      - "10.10.0.109"
      - "10.10.0.110"

# -----------------------------------------------------------------------------
# Traffic generation (Phase 2)
# -----------------------------------------------------------------------------
traffic:
  match_ratio:          0.68    # Fraction of rules to match (0.60-0.75 per scenario)
  icmp_count:           3       # ICMP echo requests per session
  inter_packet_delay:   0.5     # Seconds between packets within a session
  inter_session_delay:  1.0     # Seconds between sessions (keeps logs readable)

# -----------------------------------------------------------------------------
# Rule generation (Phase 1)
# -----------------------------------------------------------------------------
# Ratios control what fraction of the final policy count each overlap type
# occupies. They are automatically normalized, so they don't need to sum to 1.
# Clean rules always fill the remainder to ensure --count N pushes exactly N policies.
rules:
  ratios:
    shadow:          0.20   # broad rule immediately followed by narrower (unreachable) rule
    duplicate:       0.15   # identical src/dst/service pair under a different name
    subnet_overlap:  0.15   # /24 rule that makes an enclosed /28 or /32 redundant
    service_overlap: 0.15   # same src/dst, multiple services (collapsible to one rule)
    clean:           0.35   # no overlap — makes patterns non-obvious during inspection

# -----------------------------------------------------------------------------
# Lab metadata
# -----------------------------------------------------------------------------
lab:
  tag:                      "LAB-TEST-2025"
  output_dir:               "lab_output"
  rules_backup_file:        "generated_rules.json"
  analysis_report_file:     "analysis_report.json"
  observation_window_hours: 24    # Window for unused-rule detection (Phase 3)

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
logging:
  level:    "INFO"       # DEBUG | INFO | WARNING | ERROR
  log_file: "lab.log"
